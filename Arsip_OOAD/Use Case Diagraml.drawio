<mxfile host="app.diagrams.net" pages="2">
  <diagram name="Halaman-1" id="-9Lka8DavqGpnJL10VZE">
    <mxGraphModel dx="3880" dy="3062" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n&#39; Memaksa tata letak kiri-ke-kanan agar include mendatar (horizontal)\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n    BackgroundColor white\n    BorderColor black\n}\nskinparam actor {\n    BackgroundColor white\n    BorderColor black\n}\nskinparam shadow false\n\n&#39; === 1. POSISI AKTOR (Sesuai PPT Halaman 6: Aktor utama di kiri atas) ===\nactor \&quot;Karyawan\&quot; as kar\nactor \&quot;Klien Perusahaan\&quot; as klien\nactor \&quot;Peserta Tes\&quot; as pes\n\nactor \&quot;Atasan\&quot; as ats\nactor \&quot;HR / Finance\&quot; as hr\nactor \&quot;Product Manager\&quot; as pm\nactor \&quot;Engineer\&quot; as eng\nactor \&quot;QA\&quot; as qa\nactor \&quot;Tim Support\&quot; as sup\nactor \&quot;Chatbot\&quot; as bot\n\n&#39; === 2. SYSTEM BOUNDARY (Sesuai PPT Halaman 16) ===\nrectangle \&quot;Sistem Operasional Terintegrasi PT Talentyca\&quot; {\n    \n    &#39; --- MODUL KEPEGAWAIAN ---\n    usecase \&quot;Melakukan Login\&quot; as uc_login\n    usecase \&quot;Melakukan Presensi\&quot; as uc_presensi\n    usecase \&quot;Mengajukan Cuti\&quot; as uc_cuti\n    usecase \&quot;Memvalidasi Kuota Cuti\&quot; as uc_val_cuti\n    usecase \&quot;Melakukan Override Kuota\&quot; as uc_override\n    usecase \&quot;Menyetujui Cuti\&quot; as uc_app_cuti\n    usecase \&quot;Meminta Slip Gaji\&quot; as uc_slip\n\n    &#39; Aturan Include Horizontal (.right.&gt;) &amp; Extend Vertikal (.up.&gt;)\n    uc_cuti .right.&gt; uc_val_cuti : &lt;&lt;include&gt;&gt;\n    uc_override .up.&gt; uc_val_cuti : &lt;&lt;extend&gt;&gt;\n\n    &#39; --- MODUL ASSESSMENT ---\n    usecase \&quot;Menginput Data Peserta\&quot; as uc_input\n    usecase \&quot;Mengirim Email Token\&quot; as uc_email\n    usecase \&quot;Mengerjakan Soal Tes\&quot; as uc_tes\n    usecase \&quot;Mengunduh Laporan\&quot; as uc_report\n\n    uc_input .right.&gt; uc_email : &lt;&lt;include&gt;&gt;\n\n    &#39; --- MODUL DEVELOPMENT ---\n    usecase \&quot;Membuat Spesifikasi Task\&quot; as uc_spek\n    usecase \&quot;Mengembangkan Fitur\&quot; as uc_dev\n    usecase \&quot;Melakukan Testing\&quot; as uc_test\n\n    &#39; --- MODUL BUG &amp; TICKETING ---\n    usecase \&quot;Melaporkan Kendala\&quot; as uc_lapor\n    usecase \&quot;Mengekstrak Format\&quot; as uc_format\n    usecase \&quot;Menangani Isu L1/L2\&quot; as uc_l1l2\n    usecase \&quot;Mengeskalasi Isu L3\&quot; as uc_eskalasi\n    usecase \&quot;Melakukan Perbaikan Bug\&quot; as uc_hotfix\n\n    uc_lapor .right.&gt; uc_format : &lt;&lt;include&gt;&gt;\n    uc_eskalasi .up.&gt; uc_l1l2 : &lt;&lt;extend&gt;&gt;\n}\n\n&#39; === 3. ASOSIASI AKTOR (Sesuai PPT Halaman 8: Garis tanpa panah) ===\nkar -- uc_login\nkar -- uc_presensi\nkar -- uc_cuti\nkar -- uc_slip\n\nats -- uc_app_cuti\nhr -- uc_override\nhr -- uc_slip\n\nklien -- uc_login\nklien -- uc_input\nklien -- uc_report\n\npes -- uc_tes\npes -- uc_lapor\n\npm -- uc_login\neng -- uc_login\npm -- uc_spek\neng -- uc_dev\neng -- uc_hotfix\nqa -- uc_test\n\nbot -- uc_format\nsup -- uc_l1l2\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="s0CoL8jjtakBj9QdUpAp-2">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1341" width="756" x="-800" y="-510" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n    BackgroundColor white\n    BorderColor black\n}\nskinparam actor {\n    BackgroundColor white\n    BorderColor black\n}\nskinparam shadow false\n\nactor \&quot;Klien Perusahaan\&quot; as klien\nactor \&quot;Peserta Tes\&quot; as pes\n\nrectangle \&quot;Sistem Layanan Assessment\&quot; {\n    \n    usecase \&quot;Melakukan Login\&quot; as uc_login\n    usecase \&quot;Menginput Data Peserta\&quot; as uc_input\n    usecase \&quot;Mengirim Email Token\&quot; as uc_email\n    usecase \&quot;Mengunduh Laporan\&quot; as uc_report\n    usecase \&quot;Mengerjakan Soal Tes\&quot; as uc_tes\n\n    &#39; Aturan Include Horizontal\n    uc_input .right.&gt; uc_email : &lt;&lt;include&gt;&gt;\n}\n\nklien -- uc_login\nklien -- uc_input\nklien -- uc_report\n\npes -- uc_login\npes -- uc_tes\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="s0CoL8jjtakBj9QdUpAp-4">
